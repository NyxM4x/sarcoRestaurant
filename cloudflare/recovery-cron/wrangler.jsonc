{
  // El ÚNICO despertador de Sarco (14-09-2026).
  //
  // Cada minuto hace cuatro POST en paralelo, uno por recuperación: inbox de
  // webhooks, avisos al cliente, alertas de Telegram y barrido de caducados.
  // Reemplaza a los cuatro Workers que había, uno por endpoint.
  //
  // ── Por qué uno solo ──────────────────────────────────────────────────────
  //
  // El plan Free de Cloudflare admite CINCO Cron Triggers por CUENTA, y esta
  // cuenta la comparte otro restaurante del mismo operador, que ya usa tres.
  // Cuatro por restaurante no caben: dos de los de Sarco se quedaron sin cron,
  // y el 13-09-2026 el comprobante de una clienta que ya había pagado quedó
  // trabado sin que nadie lo retomara.
  //
  // Uno por restaurante sí cabe, y deja lugar para más. Una prueba de la raíz
  // (`src/lib/security/worker-tenancy.test.ts`) falla si el repo vuelve a
  // declarar más de un cron.
  //
  // ── El nombre lleva prefijo `sarco-` a propósito ──────────────────────────
  //
  // `name` es la identidad del Worker DENTRO de la cuenta de Cloudflare: dos
  // proyectos que declaren el mismo `name` son el mismo Worker, y el segundo
  // `wrangler deploy` sobrescribe al primero sin avisar.
  "name": "sarco-recovery-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",

  // Un ÚNICO Cron Trigger: una ejecución por minuto (UTC). No añadir un segundo:
  // cada expresión cuenta contra el límite de cinco de la cuenta.
  "triggers": {
    "crons": ["* * * * *"]
  },

  // Variable NO secreta: el ORIGEN de la app, sin ruta. Las cuatro rutas viven
  // en `src/cron.ts`, que es donde las contrasta la prueba con la app.
  "vars": {
    "APP_BASE_URL": "https://sarco-restaurant.vercel.app"
  },

  // Secreto OBLIGATORIO. El VALOR nunca va aquí; se entrega con
  // `wrangler secret put`. Debe coincidir con el INTERNAL_API_TOKEN de Vercel.
  "secrets": {
    "required": ["WORKER_INTERNAL_TOKEN"]
  },

  "observability": {
    "enabled": true
  }
}
