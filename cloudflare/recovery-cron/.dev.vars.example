# Ejemplo de variables para `wrangler dev` en LOCAL. Copiar a `.dev.vars`
# (gitignored) y rellenar. NUNCA versionar `.dev.vars` con valores reales.
#
# APP_BASE_URL ya se define como var pública en wrangler.jsonc; aquí solo se
# sobreescribe si se quiere apuntar a otra app en local (http solo se admite
# para localhost). Es el ORIGEN, sin ruta: las rutas las pone el Worker.
APP_BASE_URL="https://sarco-restaurant.vercel.app"

# Secreto interno. En producción se guarda con:
#   npx wrangler secret put WORKER_INTERNAL_TOKEN
# y debe coincidir con INTERNAL_API_TOKEN. Aquí va solo para pruebas locales.
WORKER_INTERNAL_TOKEN="<pega-aqui-solo-para-local-nunca-versionar>"
