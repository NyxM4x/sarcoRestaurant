{
  // Cloudflare Worker DEDICADO al barrido de pedidos caducados (09-09-2026).
  //
  // Cancela el pedido en efectivo que ya fue cotizado y que nadie confirmó ni
  // canceló en veinte minutos, y le avisa al cliente por WhatsApp.
  //
  // ── Por qué hizo falta este cuarto Worker ─────────────────────────────────
  //
  // El barrido llevaba desde el 05-09-2026 escrito y probado, y NUNCA se había
  // ejecutado en producción: vivía dentro de `GET /api/internal/cron/tick`, que
  // es el fallback de los otros tres Workers y lo despertaría un cron de Vercel
  // — pero el plan de Vercel no admite crons, y ninguno de los tres apuntaba a
  // esa ruta.
  //
  // Once pedidos en efectivo sin confirmar, el más antiguo de hacía tres días.
  // Once clientes sin el aviso de que su pedido se canceló. Y ningún error en
  // ninguna parte: un despertador que no suena es silencioso por definición.
  //
  // ── Por qué APARTE y no colgado de otro ───────────────────────────────────
  //
  // El peor caso de este tick son veinticinco avisos por WhatsApp. Si Kapso se
  // pone lento, eso se come la invocación entera. Colgarlo del Worker de
  // alertas de Telegram pondría en riesgo el aviso al grupo de reparto, y un
  // aviso de reparto que no sale es un repartidor que no sale.
  //
  // Nunca se arriesga el flujo de OPERACIONES por un proceso de LIMPIEZA.
  //
  // ── El nombre lleva prefijo `sarco-` a propósito ──────────────────────────
  //
  // `name` es la identidad del Worker DENTRO de la cuenta de Cloudflare: dos
  // proyectos que declaren el mismo `name` son el mismo Worker, y el segundo
  // `wrangler deploy` sobrescribe al primero sin avisar. Un nombre genérico
  // como `order-expiry-cron` es exactamente esa trampa cuando otro restaurante
  // del mismo operador despliega el suyo en la misma cuenta.
  //
  // `WORKER_TICK_URL` apunta al dominio de Sarco y a NADA más; lo vigila
  // `test/no-cross-tenant.test.ts`.
  "name": "sarco-order-expiry-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",

  // Un ÚNICO Cron Trigger: una ejecución por minuto (UTC). No añadir un segundo.
  //
  // Cada minuto y no cada veinte —que es el plazo que vigila— porque el plazo
  // se mide por pedido, no por tanda: un pedido que cumple sus veinte minutos
  // justo después de un barrido esperaría cuarenta si el cron fuera de veinte.
  // Un tick en vacío no cuesta nada: la consulta va por un índice parcial y la
  // mayoría de los minutos no encuentra ninguna fila.
  "triggers": {
    "crons": ["* * * * *"]
  },

  // Variable NO secreta: URL del endpoint interno en Vercel.
  "vars": {
    "WORKER_TICK_URL": "https://sarco-restaurant.vercel.app/api/internal/orders/expiry/worker/tick"
  },

  // Secreto OBLIGATORIO: un deploy sin él debe fallar. El VALOR nunca va aquí;
  // se entrega con `wrangler secret put`. Debe coincidir con INTERNAL_API_TOKEN
  // — es el mismo valor que usan los otros tres Workers.
  "secrets": {
    "required": ["WORKER_INTERNAL_TOKEN"]
  },

  "observability": {
    "enabled": true
  }
}
