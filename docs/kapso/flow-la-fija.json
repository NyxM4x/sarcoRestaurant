    {
      "id": "ORDER_SUMMARY",
      "title": "Resumen del pedido",
      "terminal": true,
      "data": {
        "order_draft_id": {
          "type": "string",
          "__example__": "e8a5de18-91dd-44fd-b372-adfa87a922fa"
        },
        "flow_token": {
          "type": "string",
          "__example__": "order_9f1c8f2e-1a2b-4c3d-8e4f-5a6b7c8d9e0f"
        },
        "summary_lines": {
          "type": "array",
          "items": { "type": "string" },
          "__example__": [
            "1x La Fija — Bs. 22",
            "1x Gaseosa personal — Bs. 8",
            "1x Porción de papas — Bs. 10"
          ]
        },
        "total_text": {
          "type": "string",
          "__example__": "Bs. 40"
        },
        "delivery_type": {
          "type": "string",
          "__example__": "delivery"
        },
        "customer_name": {
          "type": "string",
          "__example__": "Cliente Delivery"
        },
        "notes": {
          "type": "string",
          "__example__": "Sin cebolla"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Resumen de tu pedido"
          },
          {
            "type": "TextBody",
            "text": "${data.summary_lines}"
          },
          {
            "type": "TextSubheading",
            "text": "Total: ${data.total_text}"
          },
          {
            "type": "Switch",
            "value": "${data.delivery_type}",
            "cases": {
              "delivery": [
                {
                  "type": "TextBody",
                  "text": "Entrega: Delivery. Después de confirmar te pediremos tu ubicación."
                }
              ],
              "pickup": [
                {
                  "type": "TextBody",
                  "text": "Entrega: Recojo en local."
                }
              ]
            }
          },
          {
            "type": "TextCaption",
            "text": "A nombre de: ${data.customer_name}"
          },
          {
            "type": "TextCaption",
            "text": "Notas: ${data.notes}"
          },
          {
            "type": "Footer",
            "label": "Confirmar pedido",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "order_draft_id": "${data.order_draft_id}",
                "flow_token": "${data.flow_token}"
              }
            }
          }
        ]
      }
    }
  ]
